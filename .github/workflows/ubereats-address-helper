                code: `package com.ubereats.helper.service

import android.accessibilityservice.AccessibilityService
import android.content.Intent
import android.os.Handler
import android.os.Looper
import android.util.Log
import android.view.accessibility.AccessibilityEvent
import android.view.accessibility.AccessibilityNodeInfo

class UberAccessibilityService : AccessibilityService() {

    companion object {
        private const val TAG = "UberAccessibility"
        const val ACTION_ADDRESS_DETECTED = "com.ubereats.helper.ADDRESS_DETECTED"
        const val EXTRA_ADDRESS = "extra_address"
        const val EXTRA_FLOOR = "extra_floor"
    }

    private var isScanning = false

    override fun onAccessibilityEvent(event: AccessibilityEvent?) {
        if (event == null) return

        if (event.eventType == AccessibilityEvent.TYPE_WINDOW_CONTENT_CHANGED ||
            event.eventType == AccessibilityEvent.TYPE_WINDOW_STATE_CHANGED) {

            val rootNode = rootInActiveWindow ?: return

            // 1. 偵測畫面上是否有「外送」關鍵字按鈕
            if (!isScanning) {
                val deliveryNode = findNodeByText(rootNode, "外送")
                if (deliveryNode != null && deliveryNode.isClickable) {
                    startScanSequence(deliveryNode)
                }
            }
        }
    }

    private fun startScanSequence(deliveryNode: AccessibilityNodeInfo) {
        isScanning = true

        // Step 1: 點擊「外送」按鈕進入第二層
        deliveryNode.performAction(AccessibilityNodeInfo.ACTION_CLICK)

        // Step 2: 延遲 300ms 待第二層彈出後讀取
        Handler(Looper.getMainLooper()).postDelayed({
            val currentRoot = rootInActiveWindow
            if (currentRoot != null) {
                val addressText = extractAddress(currentRoot)
                val floorNum = parseFloor(addressText)

                Log.d(TAG, "成功擷取第二層地址: $addressText, 樓層: $floorNum")

                // 發送廣播給懸浮窗
                val intent = Intent(ACTION_ADDRESS_DETECTED).apply {
                    putExtra(EXTRA_ADDRESS, addressText)
                    putExtra(EXTRA_FLOOR, floorNum)
                }
                sendBroadcast(intent)

                // Step 3: 延遲 200ms 後點擊「完成」按鈕回到第一層
                Handler(Looper.getMainLooper()).postDelayed({
                    val completeBtn = findNodeByText(currentRoot, "完成")
                    completeBtn?.performAction(AccessibilityNodeInfo.ACTION_CLICK)
                    isScanning = false
                }, 200)
            } else {
                isScanning = false
            }
        }, 300)
    }

    private fun findNodeByText(node: AccessibilityNodeInfo?, target: String): AccessibilityNodeInfo? {
        if (node == null) return null
        if (node.text != null && node.text.toString().contains(target)) return node
        for (i in 0 until node.childCount) {
            val result = findNodeByText(node.getChild(i), target)
            if (result != null) return result
        }
        return null
    }

    private fun extractAddress(root: AccessibilityNodeInfo): String {
        val node = findNodeByText(root, "送達地點")
        return node?.text?.toString() ?: "未知地點"
    }

    private fun parseFloor(text: String): String {
        val numMatch = Regex("""(\\d+)\\s*樓""").find(text)
        if (numMatch != null) return numMatch.groupValues[1]

        val cnMatch = Regex("""([一二三四五六七八九十]+)\\s*樓""").find(text)
        if (cnMatch != null) return cnMatch.groupValues[1]

        return ""
    }

    override fun onInterrupt() {}
}`
