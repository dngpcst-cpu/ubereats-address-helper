class FloatingOverlayService : Service() {

    private lateinit var windowManager: WindowManager
    private lateinit var overlayView: View
    private lateinit var tvStatus: TextView
    private lateinit var tvAddress: TextView

    private val receiver = object : BroadcastReceiver() {
        override fun onReceive(context: Context?, intent: Intent?) {
            if (intent?.action == UberAccessibilityService.ACTION_ADDRESS_DETECTED) {
                val address = intent.getStringExtra(UberAccessibilityService.EXTRA_ADDRESS) ?: ""
                val floor = intent.getStringExtra(UberAccessibilityService.EXTRA_FLOOR) ?: ""
                updateOverlayUI(address, floor)
            }
        }
    }

    override fun onCreate() {
        super.onCreate()
        windowManager = getSystemService(WINDOW_SERVICE) as WindowManager
        setupOverlay()

        val filter = IntentFilter(UberAccessibilityService.ACTION_ADDRESS_DETECTED)
        registerReceiver(receiver, filter)
    }

    private fun setupOverlay() {
        val params = WindowManager.LayoutParams(
            WindowManager.LayoutParams.MATCH_PARENT,
            WindowManager.LayoutParams.WRAP_CONTENT,
            WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY,
            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE,
            PixelFormat.TRANSLUCENT
        ).apply {
            gravity = Gravity.TOP or Gravity.CENTER_HORIZONTAL
            y = 120
        }

        overlayView = LayoutInflater.from(this).inflate(R.layout.layout_floating_badge, null)
        tvStatus = overlayView.findViewById(R.id.tv_status)
        tvAddress = overlayView.findViewById(R.id.tv_address)

        windowManager.addView(overlayView, params)
    }

    private fun updateOverlayUI(address: String, floor: String) {
        CoroutineScope(Dispatchers.IO).launch {
            val db = AppDatabase.getDatabase(applicationContext)
            val record = db.addressDao().findByAddress(address)

            CoroutineScope(Dispatchers.Main).launch {
                tvAddress.text = address
                if (record != null) {
                    tvStatus.text = "\${record.floor}F \${record.type} (已記憶)"
                } else {
                    if (address.contains("醫院")) {
                        tvStatus.text = "\${floor}F 醫院/醫療場所"
                    } else {
                        tvStatus.text = "\${floor}F 樓梯/電梯大樓"
                    }
                }
            }
        }
    }

    override fun onDestroy() {
        super.onDestroy()
        if (::overlayView.isInitialized) windowManager.removeView(overlayView)
        unregisterReceiver(receiver)
    }

    override fun onBind(intent: Intent?): IBinder? = null
}`
