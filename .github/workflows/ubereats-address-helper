                </div>

                <!-- GitHub Workflow Code Preview snippet -->
                <div class="bg-[#161b22] border border-[#30363d] rounded-xl p-4">
                    <div class="flex justify-between items-center mb-2">
                        <span class="text-xs font-bold text-slate-300">Actions 腳本 Preview (.github/workflows/build-apk.yml)</span>
                        <button onclick="switchFileAndTab('github_workflow')" class="text-xs text-indigo-400 hover:text-indigo-300 font-bold">
                            查看完整程式碼 <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>
                    <pre class="bg-[#0d1117] p-3 rounded-lg text-[11px] code-font text-slate-300 overflow-x-auto">
name: Build Android APK
on: [push, workflow_dispatch]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      - name: set up JDK 17
        uses: actions/setup-java@v3
        with:
          java-version: '17'
          distribution: 'temurin'
      - name: Build Debug APK
        run: ./gradlew assembleDebug
      - name: Upload APK Artifact
        uses: actions/upload-artifact@v3
        with:
          name: UberEats-Helper-APK
          path: app/build/outputs/apk/debug/app-debug.apk</pre>
